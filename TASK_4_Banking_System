#include <stdio.h>

#define FILE_NAME "bank.dat"

struct Bank
{
    int accNo;
    char name[50];
    float balance;
};

void createAccount()
{
    FILE *fp;
    struct Bank b;

    printf("Enter Account No: ");
    scanf("%d", &b.accNo);

    printf("Enter Name: ");
    scanf(" %49[^\n]", b.name);

    printf("Enter Initial Balance: ");
    scanf("%f", &b.balance);

    if (b.accNo <= 0 || b.balance < 0)
    {
        printf("Invalid details!\n");
        return;
    }

    fp = fopen(FILE_NAME, "wb");
    if (fp == NULL)
        return;

    fwrite(&b, sizeof(b), 1, fp);
    fclose(fp);

    printf("Account Created Successfully!\n");
}

void transaction(int type)
{
    FILE *fp = fopen(FILE_NAME, "rb+");
    struct Bank b;
    float amount;

    if (fp == NULL || fread(&b, sizeof(b), 1, fp) != 1)
    {
        printf("No account found!\n");
        if (fp != NULL) fclose(fp);
        return;
    }

    if (type == 1 || type == 2)
    {
        printf("Enter Amount: ");
        if (scanf("%f", &amount) != 1 || amount <= 0)
        {
            printf("Invalid amount!\n");
            fclose(fp);
            return;
        }

        if (type == 1)
            b.balance += amount;
        else if (amount <= b.balance)
            b.balance -= amount;
        else
        {
            printf("Insufficient Balance!\n");
            fclose(fp);
            return;
        }

        rewind(fp);
        fwrite(&b, sizeof(b), 1, fp);
        printf("Transaction Successful!\n");
    }

    printf("Account: %d\nName: %s\nBalance: Rs. %.2f\n",
           b.accNo, b.name, b.balance);

    fclose(fp);
}

int main()
{
    int choice;

    do
    {
        printf("\n1.Create Account\n2.Deposit\n3.Withdraw\n");
        printf("4.Balance Enquiry\n5.Exit\nChoice: ");
        if (scanf("%d", &choice) != 1)
            return 1;

        switch (choice)
        {
            case 1: createAccount(); break;
            case 2: transaction(1); break;
            case 3: transaction(2); break;
            case 4: transaction(0); break;
            case 5: printf("Thank you!\n"); break;
            default: printf("Invalid choice!\n");
        }
    } while (choice != 5);

    return 0;
}
